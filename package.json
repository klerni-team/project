{
  "name": "habit-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_DEMO=1 vite build --base ./ --outDir dist-demo",
    "start": "node server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "contacts": "node --env-file-if-exists=.env tools/yandex-contacts/cli.ts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@astryxdesign/cli": "^0.6.6",
    "@astryxdesign/core": "^0.6.6",
    "@astryxdesign/theme-neutral": "^0.6.6",
    "@fontsource/lora": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.6.6",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
