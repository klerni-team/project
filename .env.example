# Domain pointing at this server (A record), used by Caddy for HTTPS.
DOMAIN=habits.example.com
# Password you type once on each device (min 8 chars). Required: the
# server refuses to start without it. Example: openssl rand -base64 18
APP_PASSWORD=
# Claude API key for the planning agent (https://console.anthropic.com).
ANTHROPIC_API_KEY=
